ENVIRONMENT=prod
WORKERS_COUNT=4
PORT=8000
# JWT signing key, at least 32 characters: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-string-of-32-chars-or-more
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Database
POSTGRES_HOST=ft-db
POSTGRES_PORT=5432
POSTGRES_DB=ft
POSTGRES_USER=prod
POSTGRES_PASSWORD=prod1234

# Redis
REDIS_HOST=ft-redis
REDIS_PORT=6379
REDIS_USERNAME=prod
REDIS_PASSWORD=prod1234
